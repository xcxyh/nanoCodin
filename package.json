{
  "name": "nano-codin",
  "version": "0.2.0",
  "description": "A small, customizable TypeScript coding-agent harness with a terminal CLI.",
  "private": false,
  "type": "module",
  "bin": {
    "nano-codin": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.5"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-prompts.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run test && npm run test:coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run verify && npm run test:package",
    "preversion": "npm run typecheck && npm run build && npm pack --dry-run",
    "release:patch": "npm version patch -m \"chore(release): %s\"",
    "release:minor": "npm version minor -m \"chore(release): %s\"",
    "release:major": "npm version major -m \"chore(release): %s\"",
    "prebuild": "node scripts/clean-dist.mjs",
    "test:package": "npm run build && node scripts/check-package.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.1.18",
    "@ai-sdk/openai": "^1.1.18",
    "ai": "^4.1.46",
    "execa": "^9.5.2",
    "handlebars": "^4.7.8",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@vitest/coverage-v8": "^4.0.18",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  },
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./models": {
      "types": "./dist/model/provider.d.ts",
      "import": "./dist/model/provider.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./session": {
      "types": "./dist/session/store.d.ts",
      "import": "./dist/session/store.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "import": "./dist/context/index.js"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "import": "./dist/templates/index.js"
    }
  }
}
